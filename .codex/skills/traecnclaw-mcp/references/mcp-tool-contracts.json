{
  "source": "mcp-server.js",
  "contractVersion": 5,
  "toolCount": 20,
  "tools": [
    {
      "name": "traecn_send_message",
      "description": "Send one message to TraeCN as a persistent background task. Optionally target an existing conversation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "The exact message to send."
          },
          "conversationId": {
            "type": "string",
            "description": "Stable identifier returned by traecn_list_conversations."
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "metadata": {
        "layer": "task",
        "risk": "delegate"
      }
    },
    {
      "name": "traecn_get_task",
      "description": "Read one known task. Defaults to the final result; request trace only when detailed execution history is needed for diagnosis.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "detailLevel": {
            "type": "string",
            "enum": [
              "result",
              "trace"
            ],
            "description": "result returns only the final answer (default); trace includes the full visible Trae execution process."
          }
        },
        "required": [
          "taskId"
        ],
        "additionalProperties": false
      },
      "metadata": {
        "layer": "task",
        "risk": "read"
      }
    },
    {
      "name": "traecn_cancel_task",
      "description": "Cancel one gateway-tracked task by task ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          }
        },
        "required": [
          "taskId"
        ],
        "additionalProperties": false
      },
      "metadata": {
        "layer": "task",
        "risk": "delegate",
        "destructive": true
      }
    },
    {
      "name": "traecn_stop_generation",
      "description": "Stop only the generation visible in the named active TraeCN conversation. This may interrupt work not submitted through the gateway, so the caller must acknowledge that scope and provide an audit reason.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "description": "Stable identifier returned by traecn_list_conversations."
          },
          "acknowledgeUntrackedWork": {
            "type": "boolean",
            "description": "Must be true to acknowledge that visible work may belong to the user or another agent."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Concise reason recorded in the local security audit log."
          }
        },
        "required": [
          "conversationId",
          "acknowledgeUntrackedWork",
          "reason"
        ],
        "additionalProperties": false
      },
      "metadata": {
        "layer": "task",
        "risk": "delegate",
        "destructive": true
      }
    },
